# Konfigurasi PRODUKSI — disalin install.sh menjadi deploy/.env (izin 600).
# Bukan berkas yang sama dengan .env.example di akar repo (itu untuk `pnpm dev`
# di laptop); penjelasan panjang tiap kunci NEXT_PUBLIC_* ada di sana.
#
# Nilai berkarakter khusus ($, #, spasi) ditulis dalam kutip tunggal. Jangan
# menulis kunci yang sama dua kali: yang dipakai baris terakhir.

# ------------------------------------------------------------- image
# github = tarik image yang dibangun GitHub Actions untuk commit yang ter-checkout
#          (bawaan; server tidak perlu membangun);
# lokal  = bangun di server ini — butuh 1–2 GB memori dan DITOLAK bila memori
#          tersedia di bawah 2 GB. Untuk sekali jalan: --bangun-lokal.
SUMBER_IMAGE=github
# Kosong = ghcr.io/fauzanparanditha/portfolio-frontend
IMAGE_JAUH=

# ------------------------------------------------------------- disisipkan saat BUILD
# Nilai di bagian ini DISISIPKAN ke image saat dibangun.
#   · Image dari GitHub: nilainya berasal dari VARIABEL REPO di GitHub (nama yang
#     sama). Yang ditulis di sini adalah nilai yang DIHARAPKAN server ini —
#     status.sh melaporkan bila image yang berjalan dibangun dengan nilai lain.
#   · Build lokal: nilai di sinilah yang dipakai.
# Mengubahnya selalu berarti membangun ulang image.
#
# Alamat API dari sisi BROWSER, sudah termasuk /api/v1.
NEXT_PUBLIC_API_URL=<https://api.contoh.id/api/v1>
# Alamat publik situs ini (canonical, sitemap, Open Graph). Tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=<https://contoh.id>
NEXT_PUBLIC_CV_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_LOCATION=
# Gerbang kehadiran cookie untuk /admin (src/proxy.ts). Isi `off` HANYA bila
# backend berada di domain lain sehingga cookie-nya tidak sampai ke domain ini.
ADMIN_PROXY_GATE=

# ------------------------------------------------------------- dibaca saat RUNTIME
# Mengubahnya cukup dengan: sudo ./install.sh --non-interactive
#
# Alamat API untuk fetch dari SERVER Next.js (isi halaman & sitemap), sudah
# termasuk /api/v1. Kosong = memakai NEXT_PUBLIC_API_URL. Isi bila alamat publik
# tidak terjangkau dari dalam kontainer — mis. backend di server yang sama:
#   API_INTERNAL_URL=http://host.docker.internal:8080/api/v1
# Jangan menaruh kredensial di URL ini: ia tampil di keluaran status.sh. Ikut
# dipakai saat BUILD untuk mengisi halaman yang di-prerender.
# (backend lalu harus diikat ke alamat yang terjangkau kontainer, bukan 127.0.0.1;
# lihat docs/PEMELIHARAAN.md).
API_INTERNAL_URL=

# ------------------------------------------------------------- port & jaringan
# Alamat tempat port web diikat di server ini. Port yang dipublikasikan Docker
# MELEWATI UFW/CSF, jadi nilai ini adalah keputusan keamanan:
#   127.0.0.1  hanya dari server ini — untuk reverse proxy di host yang sama (bawaan)
#   0.0.0.0    terbuka ke semua antarmuka, termasuk internet
ALAMAT_IKAT=127.0.0.1
PORT_WEB=3000
# Dipilih otomatis oleh install.sh; isi manual hanya bila ia tidak menemukan
# rentang yang bebas. (Dua kunci terakhir tidak dipakai stack ini, tetapi ikut
# ditulis fungsi bersama.)
DOCKER_SUBNET=
DOCKER_SUBNET_DALAM=
PROXY_IP=

# ------------------------------------------------------------- operasional
WEB_MEM_LIMIT=512m
# Alarm hasil update (opsional). Butuh jq dan curl.
ALARM_WEBHOOK_URL=
ALARM_TELEGRAM_BOT_TOKEN=
ALARM_TELEGRAM_CHAT_ID=
