# Base URL API backend — SUDAH termasuk prefix /api/v1, jangan diulang di path.
# Deploy satu-origin di balik reverse proxy: cukup isi path relatif `/api/v1`.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Base URL publik situs ini — dipakai untuk metadataBase, canonical, OG url,
# robots.txt, dan sitemap. Tanpa trailing slash. Fallback: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gate presence-check cookie admin di src/proxy.ts (server-side, BUKAN NEXT_PUBLIC).
# Aktif secara default. Set `off` HANYA bila backend berada di domain lain dan
# cookie sesinya tidak terkirim ke domain frontend — kalau tidak, semua kunjungan
# ke /admin akan dilempar ke halaman login. Keamanan tetap ditegakkan backend
# (RequireRole) + AdminGuard. Lihat docs/DEPLOYMENT.md di repo backend.
# PENTING: proxy berjalan di Edge runtime, jadi nilai ini di-inline saat BUILD.
# Set env-nya sebelum `pnpm build`, bukan hanya saat runtime.
# ADMIN_PROXY_GATE=off
